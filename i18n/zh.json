    "semantics": [
      {
        "scope": "search / replace_all(dryRun)",
        "behavior": "无命中返回 ok:true + count:0（非错误）",
        "action": "把「未找到」告知用户，不要重试"
      },
      {
        "scope": "read_* / list_* / read_range",
        "behavior": "空内容返回 ok:true + 空数组/空字符串（非错误）",
        "action": "正常处理空结果即可"
      },
      {
        "scope": "read_selection（Word 无选区）",
        "behavior": "返回光标上下文 \"左 | 右\"（| = 光标位置），非错误",
        "action": "把它当作光标位置信息使用"
      },
      {
        "scope": "覆盖类写入（confirm 后执行）",
        "behavior": "成功结果附 previousState/afterState/document",
        "action": "用 afterState/document 核验写入结果，不盲目信任"
      }
    ]

      },
      "requirement": {
        "meaning": "当前 Office 环境缺少所需 API（如批注 API 不可用）",
        "action": "如实告知用户该功能在当前环境不可用，绝不假装成功"
      },
      "unsupported": {
        "meaning": "该参数组合在当前环境不支持（如 Excel replace_all 的 dryRun）",
        "action": "按 error 文本换用支持的调用方式"
      },
      "execution": {
        "meaning": "执行期异常",
        "action": "把 error 原样报告给用户；若为 Office.js 环境限制，按 error 文本判断"
      }

    "ppt_ungroup_shape": {
      "args": {
        "slideId": "string",
        "groupShapeId": "string"
      }
    },
    "ppt_set_z_order": {
      "args": {
        "slideId": "string",
        "shapeIds": "string[]",
        "operation": "BringForward|BringToFront|SendBackward|SendToBack"
      }
    },
    "ppt_align_shapes": {
      "args": {
        "slideId": "string",
        "shapeIds": "string[]",
        "mode": "left|center|right|top|middle|bottom"
      }
    },
    "ppt_distribute_shapes": {
      "args": {
        "slideId": "string",
        "shapeIds": "string[]",
        "mode": "horizontal|vertical"
      }
    },
    "get_document_info": {
      "args": {
        "keys": "array 可选：要读取的 settings 键列表（如 [\"lang\",\"theme\"]）"
      }
    },
    "set_setting": {
      "args": {
        "key": "string 必填：设置键",
        "value": "any 必填：任意 JSON 值（随文档持久化，跨会话可读）"
      }
    },
    "locate_select": {
      "args": {
        "bookmark": "string 可选：Word 书签 / Excel 命名区域名",
        "anchor": "string 可选：同 bookmark",
        "text": "string 可选：定位首个匹配文本",
        "range": "string 可选(Excel)：A1:B5 或 Sheet!A1:B5",
        "address": "string 可选(Excel)：同 range",
        "sheet": "string 可选(Excel)：指定工作表",
        "blinks": "number 可选：闪烁次数(默认0=只选中保持,1-5才闪)",
        "interval": "number 可选：间隔ms(默认300,100-800)"
      }
    }
  }
}

  "capabilities": {
    "read_selection": {
      "args": {
        "withStyles": "boolean 可选：同时返回样式"
      }
    },
    "write_selection": {
      "args": {
        "text": "string 必填：替换选区的文本"
      }
    },
    "read_document": {
      "args": {
        "sheet": "string 可选(Excel)：指定工作表名"
      }
    },
    "replace_all": {
      "args": {
        "search": "string 必填",
        "replace": "string 必填",
        "dryRun": "boolean 可选：仅返回命中数不执行"
      }
    },
    "append_text": {
      "args": {
        "text": "string 必填：文末追加段落"
      }
    },
    "set_table_borders": {
      "args": {
        "color": "string 必填：#RRGGBB",
        "tableIndexes": "number[] 可选：从1开始，默认全部",
        "locations": "Top|Bottom|Left|Right|InsideHorizontal|InsideVertical 数组，可选",
        "enableGrid": "boolean 可选：先应用 TableGrid 以启用完整网格"
      }
    },
    "set_font": {
      "args": {
        "font": "string 必填：字体名"
      }
    },
    "word_list_paragraphs": {
      "args": {
        "filter": "all|empty|nonEmpty 可选，默认 all"
      }
    },
    "word_delete_paragraphs": {
      "args": {
        "targets": "array 必填：[{index,expectedText}]，index 从0开始"
      }
    },
    "insert_paragraph": {
      "args": {
        "text": "string 必填",
        "style": "string 可选：内置样式如 Heading1",
        "location": "string 可选：end|start|afterSelection|afterSelectionParagraph"
      }
    },
    "insert_table": {
      "args": {
        "rows": "array 必填：矩形二维数组，最多1000行/63列/10000单元格",
        "location": "string 可选：start|end|beforeSelection|afterSelection",
        "style": "string 可选：仅本地化/自定义表格样式名",
        "styleBuiltIn": "string 可选：跨语言内置样式枚举，如 GridTable4_Accent1；不可与 style 同用",
        "headerRow": "boolean 可选：首行为标题行"
      }
    },
    "word_insert_html": {
      "args": {
        "html": "string 必填：最大 8 MiB",
        "target": "body|selection 可选，默认 body",
        "mode": "replace|append|prepend|before|after 可选，默认 append"
      }
    },
    "word_set_page_setup": {
      "args": {
        "sections": "all|number[] 可选：从0开始，默认 all",
        "topMargin": "number 可选(points)",
        "bottomMargin": "number 可选(points)",
        "leftMargin": "number 可选(points)",
        "rightMargin": "number 可选(points)",
        "headerDistance": "number 可选(points)",
        "footerDistance": "number 可选(points)"
      }
    },
    "word_insert_equation": {
      "args": {
        "expression": "结构化公式节点：text|group|fraction|subscript|superscript",
        "target": "object 可选：{kind:selection|body|search,query/occurrence/matchCase/matchWholeWord}，occurrence 从0开始",
        "mode": "replace|before|after|prepend|append 可选，默认 after",
        "display": "boolean 可选：默认 true"
      }
    },
    "word_export_file": {
      "args": {
        "type": "docx|pdf，默认 docx"
      }
    },
    "word_insert_image": {
      "args": {
        "base64": "string 必填：PNG/JPEG base64",
        "mode": "before|after|replace 可选，默认 after",
        "width": "number 可选(px)",
        "height": "number 可选(px)"
      }
    },
    "word_transfer_content": {
      "args": {
        "source": "object 必填：{kind:selection|table|search,index/query/occurrence/matchCase}",
        "destination": "object 必填：{kind:selection|body|header|footer,section/type}",
        "operation": "copy|move 可选，默认 copy",
        "mode": "replace|append|prepend|before|after 可选，默认 append",
        "expectedText": "string 可选：写前核对源文本",
        "overwrite": "boolean 可选：替换非空目标时须 true"
      }
    },
    "apply_style": {
      "args": {
        "style": "string 必填：Heading1/标题 1/正文等",
        "scope": "string 可选：selection|all"
      }
    },
    "format_selection": {
      "args": {
        "font": "string 可选",
        "size": "number 可选",
        "bold": "boolean 可选",
        "italic": "boolean 可选",
        "color": "string 可选(#RRGGBB)",
        "highlight": "string 可选(Word)"
      }
    },
    "set_paragraph_format": {
      "args": {
        "alignment": "string 可选：left|center|right|justify",
        "indent": "number 可选(cm)",
        "lineSpacing": "number 可选",
        "listType": "string 可选：bulleted|numbered|none"
      }
    },
    "search": {
      "args": {
        "query": "string 必填",
        "matchCase": "boolean 可选",
        "wildcard": "boolean 可选：通配符"
      }
    },
    "add_comment": {
      "args": {
        "text": "string 必填",
        "selectionText": "string 可选(Word)：给含该文本的选区加批注",
        "cell": "string 可选(Excel)：A1 单元格"
      }
    },
    "word_list_sections": {
      "args": {
        "textLimit": "number 可选"
      }
    },
    "word_read_headers_footers": {
      "args": {
        "section": "number|all",
        "types": "primary|firstPage|evenPages 数组"
      }
    },
    "word_set_header_footer": {
      "args": {
        "kind": "header|footer",
        "section": "number|all",
        "type": "primary|firstPage|evenPages",
        "text": "string",
        "mode": "replace|append|prepend"
      }
    },
    "word_insert_break": {
      "args": {
        "type": "page|line|sectionNext|sectionContinuous|sectionEven|sectionOdd",
        "location": "start|end|beforeSelection|afterSelection"
      }
    },
    "word_insert_caption": {
      "description": "静态编号需 WordApi 1.1+；动态 SEQ 需 WordApi 1.5+（本机不可用）",
      "args": {
        "label": "string",
        "title": "string",
        "sequenceId": "ASCII identifier",
        "dynamic": "boolean 可选，默认 false；true 尝试动态 SEQ",
        "number": "number 可选，静态编号默认 1",
        "position": "beforeSelection|afterSelection",
        "separator": "string 可选"
      }
    },
    "read_range": {
      "args": {
        "address": "string 必填：Sheet!A1:B10",
        "limit": "number 可选：最大格数"
      }
    },
    "write_range": {
      "args": {
        "address": "string 必填",
        "values": "array 可选：二维数组",
        "formulas": "array 可选：二维数组(A1 公式)"
      }
    },
    "format_range": {
      "args": {
        "address": "string 必填",
        "font": "string 可选",
        "size": "number 可选",
        "bold": "boolean 可选",
        "fill": "string 可选(#RRGGBB)",
        "numberFormat": "string 可选",
        "autoFit": "boolean 可选",
        "tableStyle": "string 可选(如 TableStyleMedium2)",
        "tableName": "设置 tableStyle 时必填"
      }
    },
    "insert_chart": {
      "args": {
        "type": "string 必填：Line|Column|Bar|Pie|Area|Scatter 等",
        "dataRange": "string 必填：Sheet!A1:B10",
        "title": "string 可选"
      }
    },
    "add_sheet": {
      "args": {
        "name": "string 必填"
      }
    },
    "rename_sheet": {
      "args": {
        "oldName": "string 必填",
        "newName": "string 必填"
      }
    },
    "delete_sheet": {
      "args": {
        "name": "string 必填",
        "dryRun": "boolean 可选"
      }
    },
    "apply_sort": {
      "args": {
        "address": "string 必填",
        "fields": "array 必填：[{column:1,ascending:true}]"
      }
    },
    "apply_filter": {
      "args": {
        "address": "string 必填",
        "columns": "array 可选：[{column,filterType,criteria}]"
      }
    },
    "evaluate_formula": {
      "args": {
        "formula": "string 必填：如 SUM(A1:A10)"
      }
    },
    "list_tables": {
      "args": {
        "sheet": "string 可选",
        "includeValues": "boolean 可选",
        "limit": "number 可选"
      }
    },
    "create_table": {
      "args": {
        "address": "string",
        "hasHeaders": "boolean",
        "name": "string 可选",
        "style": "string 可选"
      }
    },
    "delete_table": {
      "args": {
        "name": "string"
      }
    },
    "convert_table_to_range": {
      "args": {
        "name": "string"
      }
    },
    "read_conditional_formats": {
      "args": {
        "address": "string"
      }
    },
    "add_conditional_format": {
      "args": {
        "address": "string",
        "type": "Custom|CellValue|ContainsText",
        "rule": "object",
        "format": "object 可选"
      }
    },
    "delete_conditional_format": {
      "args": {
        "address": "string",
        "id": "string"
      }
    },
    "clear_conditional_formats": {
      "args": {
        "address": "string"
      }
    },
    "read_data_validation": {
      "args": {
        "address": "string"
      }
    },
    "set_data_validation": {
      "args": {
        "address": "string",
        "rule": "object 单一验证类型",
        "ignoreBlanks": "boolean 可选",
        "errorAlert": "object 可选",
        "prompt": "object 可选"
      }
    },
    "clear_data_validation": {
      "args": {
        "address": "string"
      }
    },
    "validate_data": {
      "description": "details 需 ExcelApi 1.9+",
      "args": {
        "address": "string",
        "details": "boolean 可选"
      }
    },
    "read_slides": {
      "description": "读取当前选中的幻灯片范围（不是全文件页数）；整份演示文稿用 read_document"
    },
    "ppt_add_slides": {
      "args": {
        "count": "number 可选：1-50，默认1",
        "clearPlaceholders": "boolean 可选：默认 false"
      }
    },
    "ppt_add_elements": {
      "args": {
        "slideId": "string 必填：目标幻灯片 ID",
        "coordinateSpace": "object 必填：元素设计坐标 {width,height}",
        "targetSize": "object 必填：实际目标尺寸 points {width,height}",
        "elements": "array 必填：text|shape|line 元素；通用 x/y/w/h，文本支持 font/size/color/bold/italic/align/valign/margins/autoFit/runs，shape 支持 shapeType/fill/lineColor，line 支持 connectorType/color/lineWidth/dashStyle"
      }
    },
    "ppt_delete_slides": {
      "args": {
        "slideIds": "string[] 必填：精确幻灯片 ID；拒绝删除全部页面"
      }
    },
    "ppt_delete_shapes": {
      "args": {
        "slideId": "string 必填",
        "shapeIds": "string[] 必填：精确 shape ID；删除后返回剩余 IDs"
      }
    },
    "ppt_render_slides": {
      "args": {
        "width": "number 可选：PNG宽度，默认960",
        "height": "number 可选：PNG高度，默认540"
      }
    },
    "ppt_inspect_slides": {
      "args": {
        "slideIds": "string[] 可选"
      }
    },
    "ppt_list_placeholders": {
      "args": {
        "slideId": "string 可选"
      }
    },
    "ppt_insert_image": {
      "args": {
        "base64": "string",
        "mode": "positioned|selectionOrPlaceholder",
        "left": "number",
        "top": "number",
        "width": "number 可选",
        "height": "number 可选"
      }
    },
    "ppt_insert_table": {
      "description": "style 需 PowerPointApi 1.9+",
      "args": {
        "slideId": "string",
        "values": "矩形二维数组",
        "left": "number 可选",
        "top": "number 可选",
        "width": "number 可选",
        "height": "number 可选",
        "style": "PowerPoint.TableStyle 枚举字符串可选，如 MediumStyle2Accent1"
